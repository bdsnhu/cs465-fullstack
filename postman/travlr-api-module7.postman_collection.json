{
  "info": {
    "name": "Travlr API (Module 7 - Security)",
    "description": "Tests registration, login and JWT-protected admin endpoints. Start the API (npm start) first. Run in order; each run registers a fresh mock user and leaves the trips collection unchanged. (Mock users also available via `npm run seed:users`.)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "jwt",
      "value": ""
    },
    {
      "key": "userEmail",
      "value": ""
    },
    {
      "key": "userPassword",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Register mock user (201 + JWT)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "const b = pm.response.json();",
              "pm.test('Body has a token', () => pm.expect(b.token).to.be.a('string'));",
              "pm.test('Token has 3 parts', () => pm.expect(b.token.split('.')).to.have.lengthOf(3));",
              "const payload = JSON.parse(atob(b.token.split('.')[1]));",
              "pm.test('Payload carries email and name but no password data', () => { pm.expect(payload.email).to.eql(pm.collectionVariables.get('userEmail')); pm.expect(payload).to.not.have.any.keys('hash','salt','password'); });",
              "pm.test('Token expires in about 1 hour', () => pm.expect(payload.exp - payload.iat).to.eql(3600));"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// A unique mock user per run so the collection can be re-run",
              "pm.collectionVariables.set('userEmail', 'postman-' + Date.now() + '@travlr.test');",
              "pm.collectionVariables.set('userPassword', 'Mock#Passw0rd');"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "register"
          ]
        },
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "name",
              "value": "Postman Tester"
            },
            {
              "key": "email",
              "value": "{{userEmail}}"
            },
            {
              "key": "password",
              "value": "{{userPassword}}"
            }
          ]
        }
      }
    },
