{
  "info": {
    "name": "Travlr API (Module 5)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "GET all trips",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Content-Type is JSON', () => pm.response.to.have.header('Content-Type', /application\\/json/));",
              "pm.test('Returns an array of 3 trips', () => { const j = pm.response.json(); pm.expect(j).to.be.an('array').with.lengthOf(3); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/trips",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "trips"
          ]
        }
      }
    },
    {
      "name": "GET one trip by code (GALR261114)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Returns the Gale Reef trip', () => { const j = pm.response.json(); pm.expect(j).to.have.lengthOf(1); pm.expect(j[0].code).to.eql('GALR261114'); pm.expect(j[0].name).to.eql('Gale Reef'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/trips/GALR261114",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "trips",
            "GALR261114"
          ]
        }
      }
    },
    {
      "name": "GET one trip by code (DAWR261215)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Returns Dawson\\'s Reef', () => pm.expect(pm.response.json()[0].code).to.eql('DAWR261215'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/trips/DAWR261215",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "trips",
            "DAWR261215"
          ]
        }
      }
    },
    {
      "name": "GET one trip by code (CLAR270121)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Returns Claire\\'s Reef', () => pm.expect(pm.response.json()[0].code).to.eql('CLAR270121'));"
            ]
          }
        }
